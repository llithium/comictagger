QWidget#centralWidget { background: @canvas; color: @ink; }
QToolBar { background: @surface; border: 0; border-bottom: 1px solid @edge; padding: 3px 12px; spacing: 3px; }
QToolBar QToolButton, QWidget#welcome QPushButton { color: @ink; background: transparent; border: 1px solid transparent; border-radius: 5px; padding: 6px 9px; font-size: @bodyText; }
QToolBar QToolButton:hover, QWidget#welcome QPushButton:hover { background: @wash; }
QToolBar QToolButton:disabled { color: palette(placeholder-text); }
QToolBar::separator { width: 1px; background: @edge; margin: 7px 5px; }
QToolBar QToolButton#saveTags:enabled, QWidget#welcome QPushButton#openArchive { background: @accent; color: @onAccent; font-weight: bold; }
QWidget#welcome { background: @surface; border: 1px solid @edge; border-radius: 8px; }
QWidget#welcome QLabel { color: @muted; }
QWidget#welcome QLabel#welcomeTitle { color: @ink; font-size: @welcomeText; font-weight: bold; }
QWidget#welcome QPushButton { background: @canvas; border-color: @edge; padding: 8px 16px; }
QWidget#welcome QPushButton#blankEditor { color: @accent; background: transparent; border-color: transparent; }
QWidget#welcome QPushButton:focus, QWidget#welcome QPushButton#blankEditor:focus, QToolBar QToolButton:focus { border-color: palette(highlight); }
QLabel#lblFilename { color: @ink; font-size: @headingText; font-weight: bold; }
QLabel#lblArchiveType, QLabel#lblPageCount, QLabel#lblTagList { color: @muted; font-style: normal; }
QTabWidget#tabWidget::pane, QWidget#scrollAreaWidgetContents { background: @surface; }
QTabWidget#tabWidget::pane { border: 1px solid @edge; border-radius: 5px; }
QTabWidget#tabWidget QTabBar::tab { background: transparent; color: @muted; padding: 7px 16px; border: 1px solid transparent; border-bottom-width: 2px; }
QTabWidget#tabWidget QTabBar::tab:selected { color: @accent; border-bottom-color: @accent; font-weight: bold; }
QTabWidget#tabWidget QTabBar::tab:selected:focus { border-color: palette(highlight); }
QTabWidget#tabWidget QTabBar::tab:hover { background: @wash; }
QWidget#scrollAreaWidgetContents QLabel { color: @muted; font-size: @smallText; }
QWidget#scrollAreaWidgetContents QLabel#issueHeading, QWidget#scrollAreaWidgetContents QLabel#publicationHeading,
QWidget#scrollAreaWidgetContents QLabel#classificationHeading, QWidget#scrollAreaWidgetContents QLabel#alternateHeading {
    font-size: @headingText; font-weight: bold; color: @ink; padding-top: 6px;
}
QWidget#scrollAreaWidgetContents QLineEdit, QWidget#scrollAreaWidgetContents QComboBox {
    background: @surface; color: @ink; border: 1px solid @fieldBorder; border-radius: 4px; padding: 3px 6px; min-height: 17px;
}
QWidget#scrollAreaWidgetContents QComboBox { padding-right: 20px; }
QWidget#scrollAreaWidgetContents QLineEdit:disabled, QWidget#scrollAreaWidgetContents QComboBox:disabled { background: @wash; color: @muted; }
QWidget#scrollAreaWidgetContents QComboBox QLineEdit { border: 0; padding: 0; }
QWidget#scrollAreaWidgetContents QLineEdit:focus, QWidget#scrollAreaWidgetContents QComboBox:focus { border-color: @accent; }
QTableWidget#twList { background: @surface; border: 1px solid @edge; border-radius: 5px; color: @ink; selection-background-color: @accent; selection-color: @onAccent; }
QTableWidget#twList::item { padding: 3px 8px; }
QTableWidget#twList QHeaderView::section { background: @canvas; color: @ink; border: 0; border-bottom: 1px solid @edge; padding: 5px 8px; font-size: @smallText; font-weight: bold; }

QWidget#coverImageContainer QPushButton { background: @surface; color: @accent; border: 1px solid @edge; border-radius: 4px; font-size: @headingText; }
QWidget#coverImageContainer QPushButton:focus { border-color: palette(highlight); }
QTabWidget#tabWidget::tab-bar { alignment: left; }
QTabWidget#tabWidget QTabBar, QTabWidget#tabWidget QTabBar::tab { background: @canvas; }
QTabWidget#tabWidget QTabBar::tab:selected { background: @surface; }
QWidget#scrollAreaWidgetContents QComboBox::drop-down { border: 0; width: 23px; }
QSplitter#splitter::handle, QSplitter#editorSplitter::handle { background: @canvas; }
QSplitter#splitter::handle:hover, QSplitter#editorSplitter::handle:hover { background: @edge; }
QWidget#scrollAreaWidgetContents QComboBox::down-arrow { image: url("@chevron"); width: 12px; height: 8px; }

QWidget#scrollAreaWidgetContents QCheckBox::indicator:unchecked {
    width: 13px; height: 13px; background: @surface; border: 1px solid @muted; border-radius: 3px;
}
QWidget#scrollAreaWidgetContents QCheckBox::indicator:unchecked:disabled { background: @wash; border-color: @edge; }

/* ----- Editor / Review switch ----- */
QToolBar QToolButton#viewSwitch { border: 1px solid @edge; border-radius: 0; padding: 5px 12px; margin: 0; }
QToolBar QToolButton#viewSwitch:checked { background: @selection; color: @ink; font-weight: bold; border-color: @accent; }

/* ----- Auto-Tag review ----- */
QWidget#autoTagReview { background: @canvas; color: @ink; }
QWidget#reviewSidebar { background: @canvas; }
QWidget#reviewList { background: @surface; border-left: 1px solid @edge; border-right: 1px solid @edge; }
QWidget#reviewDetail, QLabel#emptyLabel { background: @surface; }
QLabel#emptyLabel { color: @muted; font-size: @headingText; padding: 24px; }
QSplitter#reviewSplitter::handle { background: @edge; }
QLabel#sectionLabel { color: @muted; font-size: @smallText; font-weight: bold; padding: 12px 14px 6px 14px; letter-spacing: 1px; }
QListWidget#reviewGroups, QListWidget#reviewFiles { background: transparent; border: 0; outline: 0; color: @ink; }
QLabel#attribution { color: @muted; font-size: @smallText; padding: 6px 14px; }
QLabel#attribution a { color: @accent; }
QLabel#reviewHeading { color: @ink; font-size: @headingText; font-weight: bold; }
QLabel#positionLabel, QLabel#caption, QLabel#messageLabel { color: @muted; }
QLabel#messageLabel { font-size: @bodyText; padding-top: 4px; }

QLabel#chip { border-radius: 9px; padding: 1px 9px; font-size: @smallText; font-weight: bold; }
QLabel#chip[tone="warn"] { background: @warnSoft; color: @warn; }
QLabel#chip[tone="bad"] { background: @badSoft; color: @bad; }
QLabel#chip[tone="ok"] { background: @okSoft; color: @ok; }
QLabel#chip[tone="acc"] { background: @accSoft; color: @accent; }
QLabel#chip[tone="muted"] { background: @wash; color: @muted; }

QScrollArea#candidateStrip, QWidget#candidateHolder { background: transparent; border: 0; }
QFrame#candidateCard { background: @surface; border: 1px solid @edge; border-radius: 8px; }
QFrame#candidateCard:hover { border-color: @fieldBorder; }
QFrame#candidateCard[selected="true"] { border: 2px solid @accent; background: @surface; }
QLabel#cardKey { color: @muted; font-family: monospace; font-size: @smallText; }
QLabel#cardTitle { color: @ink; font-weight: bold; }
QLabel#cardMeta { color: @muted; font-size: @smallText; }

QTableWidget#diffTable { background: @surface; border: 0; color: @ink; }
QTableWidget#diffTable::item { border-bottom: 1px solid @edge; padding: 4px 8px; }
QTableWidget#diffTable QHeaderView::section, QWidget#searchPanel QHeaderView::section {
    background: @surface; color: @muted; border: 0; border-bottom: 1px solid @edge; padding: 5px 8px; font-size: @smallText; font-weight: bold;
}

QWidget#autoTagReview QPushButton, QWidget#searchPanel QPushButton {
    background: @surface; color: @ink; border: 1px solid @edge; border-radius: 6px; padding: 6px 12px; font-size: @bodyText;
}
QWidget#autoTagReview QPushButton:hover, QWidget#searchPanel QPushButton:hover { background: @wash; }
QWidget#autoTagReview QPushButton:focus, QWidget#searchPanel QPushButton:focus { border-color: palette(highlight); }
QWidget#autoTagReview QPushButton:disabled, QWidget#searchPanel QPushButton:disabled { color: @muted; background: @canvas; }
QWidget#autoTagReview QPushButton[primary="true"]:enabled, QWidget#searchPanel QPushButton[primary="true"]:enabled {
    background: @accent; border-color: @accent; color: @onAccent; font-weight: bold;
}

QWidget#runBar { background: @surface; border-bottom: 1px solid @edge; }
QLabel#runTitle { color: @ink; font-weight: bold; }
QLabel#runCount { color: @muted; font-family: monospace; }
QProgressBar#runProgress { background: @wash; border: 0; border-radius: 4px; }
QProgressBar#runProgress::chunk { background: @ok; border-radius: 4px; }
QWidget#reviewStatus { background: @wash; border-top: 1px solid @edge; }
QWidget#reviewStatus QLabel { color: @muted; font-size: @smallText; }

/* ----- Search panel (review and Search Online) ----- */
QWidget#searchPanel { background: @surface; color: @ink; }
QWidget#searchPanel QLabel { color: @muted; }
QWidget#searchPanel QLineEdit { background: @surface; color: @ink; border: 1px solid @fieldBorder; border-radius: 5px; padding: 5px 8px; }
QWidget#searchPanel QLineEdit:focus { border-color: @accent; }
QWidget#searchPanel QTableWidget { background: @surface; color: @ink; border: 1px solid @edge; border-radius: 6px; selection-background-color: @selection; selection-color: @ink; }
QWidget#searchPanel QTableWidget::item { padding: 4px 8px; }
QDockWidget#searchDock { color: @ink; }
QDockWidget#searchDock > QWidget { background: @surface; }
